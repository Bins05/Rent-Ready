# Browser-safe values from Supabase Project Settings > API.
# Copy this file to .env to enable the authenticated Supabase mode.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-browser-safe-publishable-key

# Never add a Supabase secret key, service-role key, or database password here.
